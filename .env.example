
#Variables de base de datos Donaway en la nube
DB_NUBE_DONAWAY_DRIVER=om.mysql.cj.jdbc.Driver
DB_NUBE_DONAWAY_URL=jdbc:
DB_NUBE_DONAWAY_USER=
DB_NUBE_DONAWAY_PASSWORD=

#Variables de base de datos Donaway local
DB_LOCAL_DONAWAY_DRIVER=org.h2.Driver
DB_LOCAL_DONAWAY_URL=jdbc:h2:./donaway;MODE=Mysql;DATABASE_TO_LOWER=TRUE;;AUTO_SERVER=TRUE;TRACE_LEVEL_SYSTEM_OUT=2;INIT=RUNSCRIPT FROM './initDonaway.sql' CHARSET 'UTF-8'
DB_LOCAL_DONAWAY_USER=
DB_LOCAL_DONAWAY_PASSWORD=

#Variables de base de datos Division politica Administrativa 
DB_LOCAL_DPA_DRIVER=org.h2.Driver
DB_LOCAL_DPA_URL=jdbc:h2:./dpa;MODE=Mysql;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE;TRACE_LEVEL_SYSTEM_OUT=2;INIT=RUNSCRIPT FROM './initDpa.sql' CHARSET 'UTF-8'
DB_LOCAL_DPA_USER=
DB_LOCAL_DPA_PASSWORD=